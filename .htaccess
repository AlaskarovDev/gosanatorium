<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

RewriteRule ^update - [L]

    # Permanent redirect of duplicated language prefix: /ru/ru/xxx -> /ru/xxx (same for az, en)
    RewriteRule ^ru/ru(/.*)?$ /ru$1 [L,R=301]
    RewriteRule ^az/az(/.*)?$ /az$1 [L,R=301]
    RewriteRule ^en/en(/.*)?$ /en$1 [L,R=301]

    # Task 15: old custom-page URLs (with or without /ru) -> clean URLs in one 301 (query string kept)
    RewriteRule ^(?:ru/)?custom-page/consultant/?$ /ru/konsultaciya-vracha [L,R=301]
    RewriteRule ^(?:ru/)?custom-page/transfer/?$ /ru/transfer [L,R=301]
    RewriteRule ^(?:ru/)?custom-page/video/?$ /ru/video [L,R=301]



    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^$1 [N]

    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ public/$1

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ server.php


</IfModule>
